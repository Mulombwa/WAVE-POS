<Window x:Class="WavePOS.Desktop.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Card}" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="ValueBox" FontSize="16" Padding="8,6" BorderBrush="{StaticResource Border}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource PosButton}" Width="100" IsCancel="True" Margin="0,0,10,0" />
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" FontSize="15" MinWidth="120"
                    Background="{StaticResource Brand}" BorderBrush="{StaticResource Brand}" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
