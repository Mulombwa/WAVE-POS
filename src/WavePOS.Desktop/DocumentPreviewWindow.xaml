<Window x:Class="WavePOS.Desktop.DocumentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:branding="clr-namespace:WavePOS.Desktop.Branding"
        Title="WAVE POS — Preview" Width="980" Height="860" MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#E4E8EF"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="PaperBox" Width="170" Margin="0,0,10,0" VerticalContentAlignment="Center"
                              DisplayMemberPath="Label" SelectionChanged="OnPaperChanged" ToolTip="Paper size" />
                    <Button Content="Close" Style="{StaticResource PosButton}" Width="100" IsCancel="True" Margin="0,0,10,0" />
                    <Button x:Name="PrintButton" Content="Print…" Style="{StaticResource PrimaryButton}" FontSize="15" Width="130"
                            Background="{StaticResource Brand}" BorderBrush="{StaticResource Brand}" Click="OnPrint" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="To save as PDF, click Print and choose “Microsoft Print to PDF”." Foreground="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,8">
            <branding:BuiltByWave HorizontalAlignment="Right" />
        </Border>

        <!-- The page -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border x:Name="Page" Background="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" />
                </Border.Effect>
                <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" Focusable="False" />
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
