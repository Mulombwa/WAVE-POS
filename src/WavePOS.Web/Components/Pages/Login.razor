@page "/login"
@layout BareLayout
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject BusinessRegistry Businesses
@inject NavigationManager Navigation

@* Static server-rendered form: the sign-in cookie is set on a normal HTTP POST. *@
<PageTitle>Sign in · WAVE POS</PageTitle>

<div class="login">
    <section class="login-brand">
        <div class="login-logo">
            <img src="/img/wave-logo.svg" alt="WAVE POS" />
            <p>Point of sale &amp; business management</p>
        </div>
        <p class="login-date">@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
    </section>

    <section class="login-form-side">
        <div class="card login-card">
            <h1>Sign in</h1>
            <p class="muted">Enter your business code, username and PIN or password.</p>

            <EditForm Model="Input" method="post" OnSubmit="SubmitAsync" FormName="login">
                <label class="field">
                    <span>Business code</span>
                    <InputText @bind-Value="Input.BusinessCode" autocomplete="organization" autocapitalize="none" spellcheck="false"
                               autofocus="@(string.IsNullOrEmpty(Input.BusinessCode))" placeholder="e.g. mwila-salon" />
                </label>
                <label class="field">
                    <span>Username</span>
                    <InputText @bind-Value="Input.Username" autocomplete="username" autocapitalize="none"
                               autofocus="@(!string.IsNullOrEmpty(Input.BusinessCode))" />
                </label>
                <label class="field">
                    <span>PIN or password</span>
                    <InputText type="password" @bind-Value="Input.Password" autocomplete="current-password" />
                </label>

                @if (_error is not null)
                {
                    <div class="alert error" role="alert">@_error</div>
                }

                <button type="submit" class="btn primary block large">Sign in</button>
            </EditForm>
            <p class="center muted signup-link">New here? <a href="/welcome">Create a free business account</a></p>
        </div>
        <BuiltByWave />
    </section>
</div>

@code {
    private const string BusinessCookie = "WavePOS.Business";

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    // Set from the posted form; created in OnInitialized for the first (GET) render.
#pragma warning disable CS8618
    [SupplyParameterFromForm] private LoginInput Input { get; set; }
#pragma warning restore CS8618
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "business")] private string? BusinessQuery { get; set; }

    private string? _error;

    protected override void OnInitialized()
    {
        Input ??= new(); // first, because the page still renders while redirecting
        if (!Businesses.Any() && !HttpMethods.IsPost(HttpContext.Request.Method))
        {
            Navigation.NavigateTo("/welcome", forceLoad: true); // nobody has signed up yet
            return;
        }
        if (string.IsNullOrEmpty(Input.BusinessCode))
            Input.BusinessCode = BusinessQuery ?? HttpContext.Request.Cookies[BusinessCookie] ?? "";
    }

    private async Task SubmitAsync()
    {
        var password = Input.Password;
        Input.Password = ""; // never send a password back to the browser

        if (string.IsNullOrWhiteSpace(Input.BusinessCode)) { _error = "Enter your business code."; return; }
        if (string.IsNullOrWhiteSpace(Input.Username)) { _error = "Enter your username."; return; }
        if (string.IsNullOrEmpty(password)) { _error = "Enter your PIN or password."; return; }

        var business = Businesses.Find(Input.BusinessCode);
        if (business is null) { _error = "No business has that code. Check with your manager, or create a business account."; return; }
        if (!business.IsActive) { _error = "This business account is suspended. Contact Wave support."; return; }

        var result = new UserRepository(Businesses.Database(business)).Authenticate(Input.Username, password);
        _error = result.Status switch
        {
            LoginStatus.Success => null,
            LoginStatus.LockedOut => $"Too many wrong attempts. Try again after {result.LockedUntil:HH:mm}.",
            LoginStatus.Disabled => "This account has been disabled. Ask your admin.",
            _ => "Wrong username or password.",
        };
        if (result.User is not { } user || _error is not null) return;

        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme,
            UserClaims.ToPrincipal(user, business.Id, CookieAuthenticationDefaults.AuthenticationScheme));
        // Remember the business code on this device so staff only type it once.
        HttpContext.Response.Cookies.Append(BusinessCookie, business.Code, new CookieOptions
        {
            HttpOnly = true, SameSite = SameSiteMode.Lax, Secure = HttpContext.Request.IsHttps, Expires = DateTimeOffset.Now.AddYears(1),
        });
        Navigation.NavigateTo(SafeReturnUrl(user, business), forceLoad: true);
    }

    // Only local addresses (no open redirects). With none, the person's home page.
    private string SafeReturnUrl(User user, Business business) =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl != "/" && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl
            : user.Role.HomePage(business.Modules);

    private sealed class LoginInput
    {
        public string BusinessCode { get; set; } = "";
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
