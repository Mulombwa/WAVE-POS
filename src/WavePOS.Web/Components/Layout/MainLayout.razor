@inherits LayoutComponentBase
@inject CurrentBusiness Current

<div class="app">
    <header class="topbar">
        <a class="brand" href="@(Current.Business is null ? "/welcome" : "/start")" title="Getting started">
            <img src="@Branding.LogoUrl(_profile)" alt="@_profile.Name logo" />
            <span class="brand-divider"></span>
            <span class="brand-name">@_profile.Name</span>
        </a>
        <AuthorizeView>
            <Authorized>
                @{ var role = context.User.ToUser().Role; var modules = Current.Modules; }
                <nav class="topnav" aria-label="Main">
                    @if (role.Can(Permission.Sell, modules))
                    {
                        <NavLink href="/" Match="NavLinkMatch.All">Till</NavLink>
                    }
                    @foreach (var (href, label, permission) in Sections)
                    {
                        @if (role.Can(permission, modules))
                        {
                            <NavLink href="@href">@label</NavLink>
                        }
                    }
                </nav>
                <span class="who">@context.User.Identity?.Name · @role.Label()@(Current.Business is { } b ? $" · {b.Code}" : "")</span>
                <form method="post" action="/logout" class="logout">
                    <AntiforgeryToken />
                    <button type="submit" class="btn outline small">Log out</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="content">
        @Body
    </main>

    <footer class="footer">
        <BuiltByWave />
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private static readonly (string Href, string Label, Permission Permission)[] Sections =
    [
        ("/inventory", "Inventory", Permission.ViewInventory),
        ("/customers", "Customers", Permission.ViewCustomers),
        ("/sales", "Sales orders", Permission.ViewSalesOrders),
        ("/purchasing", "Purchasing", Permission.ViewPurchasing),
        ("/returns", "Returns", Permission.ProcessReturns),
        ("/accounting", "Accounts", Permission.ViewAccounts),
        ("/hr", "HR & payroll", Permission.ViewEmployees),
        ("/staff", "Staff", Permission.ManageStaff),
        ("/audit", "Audit trail", Permission.ViewAuditLog),
        ("/settings", "Settings", Permission.ManageSettings),
        ("/settings/modules", "Modules", Permission.ManageModules),
    ];

    private BusinessProfile _profile = new() { Name = "WAVE POS" };

    // Only the signed-in business's own details; before sign-in there's no business to show.
    protected override void OnParametersSet() =>
        _profile = Current.Business is null ? new BusinessProfile { Name = "WAVE POS" } : new SettingsRepository(Current.Database).GetBusinessProfile();
}
